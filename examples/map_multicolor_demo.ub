# map_multicolor_demo.ub
# UltimateBasic version of VisualAssembler's samples/map-multicolor.asm.
#
# The VisualAssembler map binary is embedded directly at compile time.
# Put MAPCHAR on device 8 (for example with --d64/--add) so the custom
# 2048-byte charset can be loaded to $2000 at runtime.

load "MAPCHAR", $2000

# VIC bank 0, screen $0400, custom charset $2000.
poke $DD00, (peek($DD00) and $FC) or $03
poke $D018, $18

color border 0
map load "map_multicolor_demo.bin"
map draw 0, 0

loop
end
